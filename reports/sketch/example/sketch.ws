    ["text"]="-- list_max: synthesized from 4 examples (size 2, 20 candidates tried)\nlocal function maxl(xs) local m = xs[1] for i = 2, #xs do if xs[i] > m then m = xs[i] end end return m end\nfunction list_max(xs)\n  return maxl(xs)\nend\n"
