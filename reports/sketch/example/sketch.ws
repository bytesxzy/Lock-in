  [126]={
   ["args"]={
    ["new"]="-- any_neg: synthesized from 8 examples (size 6, 35186 candidates tried)\nlocal function minl(xs) local m = xs[1] for i = 2, #xs do if xs[i] < m then m = xs[i] end end return m end\nlocal function append(xs, v) local r = {} for i = 1, #xs do r[i] = xs[i] end r[#r + 1] = v return r end\nfunction any_neg(xs)\n  return (minl(append(xs, 0)) < 0)\nend\n",
    ["old"]="-- any_neg: synthesized from 5 examples (size 4, 1368 candidates tried)\nfunction any_neg(xs)\n  return (prod(xs) < 1)\nend\n"
   },
