  [198]={
   ["args"]={
    ["text"]="-- count_a: synthesized from 5 examples (size 3, 609 candidates tried)\nlocal function scount(s, c) local n = 0 for i = 1, #s do if s:sub(i, i) == c then n = n + 1 end end return n end\nfunction count_a(s)\n  return scount(s, \"a\")\nend\n"
   },
