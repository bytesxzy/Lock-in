  [89]={
   ["args"]={
    ["new"]="-- count_even: synthesized from 10 examples (size 3, 122840 candidates tried)\nlocal function countby(f, xs) local c = 0 for i = 1, #xs do if f(xs[i]) then c = c + 1 end end return c end\nfunction count_even(xs)\n  return countby(function(v) return ((v % 2) < 1) end, xs)\nend\n",
    ["old"]="-- count_even: synthesized from 5 examples (size 7, 94280 candidates tried)\nlocal function tail(xs) local r = {} for i = 2, #xs do r[#r + 1] = xs[i] end return r end\nlocal function append(xs, v) local r = {} for i = 1, #xs do r[i] = xs[i] end r[#r + 1] = v return r end\nfunction count_even(xs)\n  return (sum(tail(append(xs, 1))) % 4)\nend\n"
   },
